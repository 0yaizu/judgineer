PORT=3001

# 検査対象のフォルダ（相対パスの基準は apps/backend。ホームや / は指定不可）
# 例: TARGET_DIR=../../samples/clinic_results_api
# TARGET_DIR=
# 検査対象のコピーなどを置く場所（既定: <リポジトリルート>/data）
# DATA_DIR=
# SQLite のファイル（既定: <DATA_DIR>/app.db。":memory:" も可）
# DATABASE_URL=
# Claude Code（Proプラン）の設定
# CLAUDE_BIN=claude
# CLAUDE_MODEL=sonnet
# AI_TIMEOUT=600
